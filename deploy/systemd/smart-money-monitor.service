[Unit]
Description=Smart Money confirmed trades and MAS delivery
After=network-online.target polydata-polygon-rpc-tunnel.service polydata-vps-http-proxy.service

[Service]
Type=simple
WorkingDirectory=%h/develop/polymarket/repos/smart-money
Environment=SMART_MONEY_ENV_FILE=%h/develop/polymarket/repos/smart-money/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/.conda/envs/smart-money/bin/smart-money monitor --watch --watchlist var/wallet_acceptance.json --output var/wallet_monitor.json
Restart=always
RestartSec=15
KillSignal=SIGINT
TimeoutStopSec=90
UMask=0077

[Install]
WantedBy=default.target
