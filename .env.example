# Optional environment file for smart-money analyze, watchlist and monitor.
# It is read only when SMART_MONEY_ENV_FILE names it explicitly.
# Keep credentials outside this repository.
# SMART_MONEY_SOURCES_FILE=/absolute/path/to/external_sources.json
# Direct evidence only; keep cited content blocks together with saved MAS results.
# SMART_MONEY_EVIDENCE_DIR=/absolute/path/to/evidence
# Optional production networks excluded from public evidence retrieval.
# SMART_MONEY_EVIDENCE_DENY_CIDRS=
# Local Qwen3.8-27B only; no paid model or secondary-provider fallback.
# SMART_MONEY_QWEN_BASE_URL=http://127.0.0.1:30000/v1
# Requires the installed smart-money-qwen user service; never starts for offline analysis.
# SMART_MONEY_QWEN_AUTOSTART=1
# SMART_MONEY_QWEN_STARTUP_SECONDS=600
# SMART_MONEY_QWEN_TIMEOUT_SECONDS=600
# SMART_MONEY_QWEN_INPUT_MAX_CHARS=32000
# SMART_MONEY_QWEN_MAX_ATTEMPTS=3

# Polygon 137 read-only RPC endpoints for monitor; reuse existing authorized connectivity.
# POLYDATA_ORDERFILLED_RPC_URLS=https://your-polygon-rpc.example

# Existing XUE-LAB databases; loaded only via SMART_MONEY_ENV_FILE.
# xue_lab_ip=your-host
# xue_lab_user=your-ssh-user
# xue_lab_pwd=your-ssh-password
# XUE_LAB_POSTGRES_PORT=45432
# POLYDATA_POSTGRES_DATABASE=poly_data_core
# POLYDATA_POSTGRES_USER=your-read-user
# POLYDATA_POSTGRES_PASSWORD=your-database-password
# Existing XUE-LAB ClickHouse; the HTTP port is accessed through the same SSH connection.
# POLYDATA_ORDERFILLED_CLICKHOUSE_HTTP_URL=http://127.0.0.1:8123
# POLYDATA_ORDERFILLED_CLICKHOUSE_USER=your-read-user
# POLYDATA_ORDERFILLED_CLICKHOUSE_PASSWORD=your-database-password
